# A stub curl for tests/manager_startup_test.sh: the GETs modules/projects/ci/files/manager-startup.sh makes, answered
# from STUB_MANAGER: the metadata server (attributes/<key>, the project tacplus-ci, the VM's token vm-token), the
# bucket's objects (objects/<name>/<sha256>) and Secret Manager's runner-token-<pool> (glrt-<pool>-token), the last two
# only with the VM's token; and the attributes directory's ETag (-D), the next line of STUB_MANAGER/etags each time,
# as the metadata server answers a wait_for_change (#46); the VM's name and zone, STUB_MANAGER/name
# (runner-manager-new without it) and us-central1-b; and Compute Engine's API, with the VM's token only and a POST only
# with a body (Google's 411), tests/stub/manager/compute-api's (#48, #49). An unknown URL or a missing object fails, as
# curl -f does (22). Each call is logged to STUB_MANAGER/calls: its method and URL, and the bearer token it sent; a
# --data body on the next line (a --data-binary body is a file, compute-api's to read).
set -euo pipefail
out=/dev/stdout url='' auth='' headers='' method=GET data='' body='' sent=''
while [ $# -gt 0 ]; do
  case $1 in
    -o) out=$2; shift ;;
    --data-binary) body=${2#@} sent=1; shift ;;
    -D) headers=$2; shift ;;
    -X) method=$2; shift ;;
    --data) data=$2 sent=1; shift ;;
    -H) [[ $2 == @* ]] && auth=$(sed -n 's/^Authorization: Bearer //p' "${2#@}"); shift ;;
    --retry) shift ;;
    -*) ;;
    *) url=$1 ;;
  esac
  shift
done
echo "$method $url${auth:+ Bearer $auth}" >> "$STUB_MANAGER/calls"
[ "$method" = GET ] || [ -n "$body" ] || echo "$data" >> "$STUB_MANAGER/calls"
md=http://metadata.google.internal/computeMetadata/v1
case $url in
  "$md/instance/attributes/?recursive=true"*)
    [ -n "$headers" ] && [ -s "$STUB_MANAGER/etags" ] || exit 22
    e=$(head -n1 "$STUB_MANAGER/etags"); sed -i 1d "$STUB_MANAGER/etags"
    printf 'HTTP/1.1 200 OK\r\nETag: %s\r\n\r\n' "$e" > "${headers/#-//dev/stdout}"; printf '{}' > "$out" ;;
  "$md/project/project-id") printf tacplus-ci > "$out" ;;
  "$md/instance/name") cat "$STUB_MANAGER/name" 2>/dev/null > "$out" || printf runner-manager-new > "$out" ;;
  "$md/instance/zone") printf projects/123/zones/us-central1-b > "$out" ;;
  "$md/instance/service-accounts/default/token") printf '{"access_token": "vm-token", "expires_in": 3599}' > "$out" ;;
  "$md/instance/attributes/"*) f=$STUB_MANAGER/attributes/${url#"$md/instance/attributes/"}; [ -f "$f" ] || exit 22; cat "$f" > "$out" ;;
  https://storage.googleapis.com/storage/v1/b/tacplus-ci-runner-bin/o/*'?alt=media')
    [ "$auth" = vm-token ] || exit 22
    o=${url#https://storage.googleapis.com/storage/v1/b/tacplus-ci-runner-bin/o/}; o=${o%\?alt=media}
    f=$STUB_MANAGER/objects/${o//%2F//}; [ -f "$f" ] || exit 22; cat "$f" > "$out" ;;
  https://secretmanager.googleapis.com/v1/projects/tacplus-ci/secrets/runner-token-*/versions/latest:access)
    [ "$auth" = vm-token ] || exit 22
    p=${url#*/secrets/runner-token-}; p=${p%%/*}
    printf '{"payload": {"data": "%s"}}' "$(printf 'glrt-%s-token' "$p" | base64 -w0)" > "$out" ;;
  https://compute.googleapis.com/compute/v1/projects/tacplus-ci/*)
    [ "$auth" = vm-token ] || exit 22
    [ "$method" != POST ] || [ -n "$sent" ] || exit 22  # 411: a POST without a body's length
    compute-api "$method" "${url#https://compute.googleapis.com/compute/v1/projects/tacplus-ci/}" "$body" > "$out" ;;
  *) exit 22 ;;
esac
