# A stub curl for tests/handoff_test.sh: `curl -sS -X METHOD -o OUT -D HEADERS -w '%{http_code}' -H @AUTH URL`, as
# ci/handoff.sh calls it. It answers from STUB_HANDOFF/api.json, a map of "METHOD path?query" (the path under
# /api/v4) to {"body": ..., "status": 200 by default, "next": the X-Next-Page header, none by default}; anything else
# is a 404. It logs each call ("METHOD path?query") to STUB_HANDOFF/calls and the header file's lines to
# STUB_HANDOFF/headers.
set -euo pipefail
out=/dev/stdout headers=/dev/null url='' method=GET
while [ $# -gt 0 ]; do
  case $1 in
    -o) out=$2; shift ;;
    -D) headers=$2; shift ;;
    -X) method=$2; shift ;;
    -w) shift ;;
    -H) [[ $2 == @* ]] && cat "${2#@}" >> "$STUB_HANDOFF/headers"; shift ;;
    -*) ;;
    *) url=$1 ;;
  esac
  shift
done
key="$method ${url#https://gitlab.com/api/v4}"
echo "$key" >> "$STUB_HANDOFF/calls"
answer=$(jq -c --arg k "$key" '.[$k] // {"status": 404, "body": {"message": "404 Not Found"}}' "$STUB_HANDOFF/api.json")
jq -c '.body' <<< "$answer" > "$out"
jq -r 'if .next then "HTTP/2 200\r\nx-next-page: \(.next)\r\n" else "HTTP/2 200\r\n" end' <<< "$answer" > "$headers"
jq -r '.status // 200' <<< "$answer" | tr -d '\n'
