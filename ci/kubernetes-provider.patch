+func TestGetTypeByGVKV3Extensions(t *testing.T) {
+	sampleSchema := map[string]interface{}{
+		"type": "object",
+		"properties": map[string]interface{}{
+			"port": map[string]interface{}{
+				"x-kubernetes-int-or-string": true,
+			},
+			"config": map[string]interface{}{
+				"type":                                 "object",
+				"x-kubernetes-preserve-unknown-fields": true,
+			},
+			"labels": map[string]interface{}{
+				"type":                 "object",
+				"additionalProperties": map[string]interface{}{"type": "string"},
+			},
+			"args": map[string]interface{}{
+				"type":  "array",
+				"items": map[string]interface{}{"type": "string"},
+			},
+		},
+	}
+	j, err := json.Marshal(SchemaToSpec("", sampleSchema))
+	if err != nil {
+		t.Fatalf("Error: %+v", err)
+	}
+	f, err := NewFoundryFromSpecV3(j)
+	if err != nil {
+		t.Fatalf("Error: %+v", err)
+	}
+	rt, th, err := f.GetTypeByGVK(schema.GroupVersionKind{})
+	if err != nil {
+		t.Fatalf("Error: %+v", err)
+	}
+	want := tftypes.Object{AttributeTypes: map[string]tftypes.Type{
+		"port":   tftypes.String,
+		"config": tftypes.DynamicPseudoType,
+		"labels": tftypes.Map{ElementType: tftypes.String},
+		"args":   tftypes.List{ElementType: tftypes.String},
+	}}
+	if !rt.Equal(want) {
+		t.Fatalf("\nRETURNED type: %#v\nEXPECTED type: %#v", rt, want)
+	}
+	wantHints := map[string]string{
+		tftypes.NewAttributePath().WithAttributeName("port").String():   "io.k8s.apimachinery.pkg.util.intstr.IntOrString",
+		tftypes.NewAttributePath().WithAttributeName("config").String(): manifest.PreserveUnknownFieldsLabel,
+	}
+	if !reflect.DeepEqual(th, wantHints) {
+		t.Fatalf("\nRETURNED hints: %#v\nEXPECTED hints: %#v", th, wantHints)
+	}
+}
