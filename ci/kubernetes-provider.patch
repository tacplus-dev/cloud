+
+// v3Schemas gives the definitions of an OpenAPI v2 spec as the OpenAPI v3 schemas getTypeFromSchema reads (kin-openapi's
+// openapi2 has its own Schema type): the fields it reads, each nil where it is nil, and references as they are.
+func v3Schemas(defs openapi2.Schemas) map[string]*openapi3.SchemaRef {
+	if defs == nil {
+		return nil
+	}
+	v3 := make(map[string]*openapi3.SchemaRef, len(defs))
+	for k, v := range defs {
+		v3[k] = v3SchemaRef(v)
+	}
+	return v3
+}
+
+func v3SchemaRef(ref *openapi2.SchemaRef) *openapi3.SchemaRef {
+	if ref == nil {
+		return nil
+	}
+	v3 := &openapi3.SchemaRef{Ref: ref.Ref}
+	if v := ref.Value; v != nil {
+		v3.Value = &openapi3.Schema{
+			Extensions:           v.Extensions,
+			Type:                 v.Type,
+			Format:               v.Format,
+			Items:                v3SchemaRef(v.Items),
+			Properties:           v3Schemas(v.Properties),
+			AdditionalProperties: v.AdditionalProperties,
+		}
+	}
+	return v3
+}
